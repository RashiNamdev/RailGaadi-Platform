# RailGaadi Environment Configuration

# Set to true to enable live external APIs (RailRadar, OpenWeather, MapTiler)
VITE_USE_LIVE_API=false

# Third-Party API Keys (Required for Live External Data)
VITE_RAILRADAR_API_KEY=your_railradar_api_key_here
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# Backend API Endpoint (if using custom backend server)
VITE_API_BASE_URL=http://localhost:3001/api
